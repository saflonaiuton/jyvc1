# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Set to 1 when running behind a trusted reverse proxy (Render, Heroku, Nginx)
TRUST_PROXY=0
# Comma-separated allowed origins for Socket.IO CORS (leave empty = allow same origin)
# CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# ── Supabase (OPTIONAL — only needed to persist reports) ──
# Leave blank to run the full app without a database.
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── TURN server (recommended for restrictive networks) ────
# STUN works for most users. TURN is a relay fallback.
# Example for a generic/coturn provider:
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# For a TURN provider that supports temporary credentials (e.g. Metered,
# Twilio, Xirsys), generate short-lived credentials server-side and inject
# them via /api/ice instead of hardcoding long-lived secrets here.
